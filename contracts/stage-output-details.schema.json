{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-data-profiler.invalid/v1/stage-output-details.schema.json",
  "title": "Stage Output Detail Inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "outputs"],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stageId", "items"],
        "properties": {
          "stageId": { "enum": ["extract-semantics", "generate-relationship-hypotheses", "quality-freshness", "lineage-usage"] },
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["itemId", "assetId", "outcome", "summary", "evidenceRefs"],
              "properties": {
                "itemId": { "type": "string", "minLength": 1, "maxLength": 200 },
                "assetId": { "type": "string", "minLength": 1, "maxLength": 200 },
                "outcome": { "enum": ["completed", "unavailable", "not-applicable"] },
                "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
                "evidenceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } }
              }
            }
          }
        }
      }
    }
  }
}
