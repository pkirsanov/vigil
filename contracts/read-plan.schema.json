{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-data-profiler.invalid/v1/read-plan.schema.json",
  "title": "Typed Read Plan Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["planId", "sourceId", "requestedSourceVersion", "requestedManifestVersion", "purpose", "parameters", "operations", "limits", "evidenceRefs"],
  "properties": {
    "planId": { "type": "string", "format": "uuid" },
    "sourceId": { "type": "string", "format": "uuid" },
    "requestedSourceVersion": { "type": "string", "minLength": 1, "description": "A non-authoritative version assertion checked after authorization." },
    "requestedManifestVersion": { "type": "string", "minLength": 1, "description": "A non-authoritative projection assertion checked after authorization." },
    "purpose": { "enum": ["profile", "validate-identity", "validate-relationship", "analyze", "verify-result"] },
    "parameters": {
      "type": "array", "maxItems": 100,
      "items": { "$ref": "#/$defs/parameter" }
    },
    "operations": {
      "type": "array", "minItems": 1, "maxItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/tabularQuery" },
          { "$ref": "#/$defs/apiRead" },
          { "$ref": "#/$defs/streamWindow" },
          { "$ref": "#/$defs/documentRead" },
          { "$ref": "#/$defs/graphTraversal" },
          { "$ref": "#/$defs/mediaSegmentRead" },
          { "$ref": "#/$defs/lineageRead" },
          { "$ref": "#/$defs/referenceRead" }
        ]
      }
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["maximumRows", "maximumBytes", "timeoutSeconds"],
      "properties": {
        "maximumRows": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maximumBytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 30 }
      }
    },
    "evidenceRefs": { "type": "array", "minItems": 1, "items": { "type": "string", "format": "uuid" } }
  },
  "$defs": {
    "parameter": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "type", "required"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" },
        "type": { "enum": ["string", "integer", "number", "boolean", "date-time", "string-array"] },
        "required": { "type": "boolean" },
        "minimum": { "type": ["number", "null"] },
        "maximum": { "type": ["number", "null"] },
        "maximumLength": { "type": ["integer", "null"], "minimum": 1 },
        "allowedValues": { "type": "array", "maxItems": 1000 }
      }
    },
    "filter": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "operator", "parameterRef"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["equals", "not-equals", "less-than", "less-than-or-equal", "greater-than", "greater-than-or-equal", "contains", "starts-with", "in", "between", "is-null", "is-not-null"] },
        "parameterRef": { "type": ["string", "null"] }
      }
    },
    "aggregation": {
      "type": "object", "additionalProperties": false,
      "required": ["function", "path", "alias"],
      "properties": {
        "function": { "enum": ["count", "distinct-count", "sum", "average", "minimum", "maximum", "percentile"] },
        "path": { "type": ["string", "null"] },
        "alias": { "type": "string", "minLength": 1 }
      }
    },
    "parameterBinding": {
      "type": "object", "additionalProperties": false,
      "required": ["parameterRef"],
      "properties": { "parameterRef": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$" } }
    },
    "tabularQuery": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "operation", "assetId", "projection", "filters", "aggregations", "relationshipIds"],
      "properties": {
        "operationId": { "type": "string", "format": "uuid" },
        "operation": { "const": "tabular-query" },
        "assetId": { "type": "string", "minLength": 1 },
        "projection": { "type": "array", "maxItems": 500, "items": { "type": "string" } },
        "filters": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/filter" } },
        "aggregations": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/aggregation" } },
        "relationshipIds": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "apiRead": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "operation", "sourceOperationId", "method", "parameterBindings", "maximumPages", "maximumItems"],
      "properties": {
        "operationId": { "type": "string", "format": "uuid" },
        "operation": { "const": "api-read" },
        "sourceOperationId": { "type": "string", "minLength": 1 },
        "method": { "enum": ["GET", "HEAD"] },
        "parameterBindings": { "type": "object", "maxProperties": 100, "additionalProperties": { "$ref": "#/$defs/parameterBinding" } },
        "maximumPages": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "maximumItems": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "streamWindow": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "operation", "eventTypeId", "startParameterRef", "endParameterRef", "maximumEvents"],
      "properties": {
        "operationId": { "type": "string", "format": "uuid" },
        "operation": { "const": "stream-window" },
        "eventTypeId": { "type": "string", "minLength": 1 },
        "startParameterRef": { "type": "string", "minLength": 1 },
        "endParameterRef": { "type": "string", "minLength": 1 },
        "maximumEvents": { "type": "integer", "minimum": 1, "maximum": 1000000 }
      }
    },
    "documentRead": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "operation", "assetId", "documentIdParameterRef", "segmentIds", "maximumDocuments"],
      "properties": {
        "operationId": { "type": "string", "format": "uuid" },
        "operation": { "const": "document-read" },
        "assetId": { "type": "string", "minLength": 1 },
        "documentIdParameterRef": { "type": "string", "minLength": 1 },
        "segmentIds": { "type": "array", "maxItems": 1000, "items": { "type": "string", "minLength": 1 } },
        "maximumDocuments": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "graphTraversal": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "operation", "assetId", "startNodeParameterRef", "edgeKinds", "direction", "maximumDepth", "maximumNodes"],
      "properties": {
        "operationId": { "type": "string", "format": "uuid" },
        "operation": { "const": "graph-traversal" },
        "assetId": { "type": "string", "minLength": 1 },
        "startNodeParameterRef": { "type": "string", "minLength": 1 },
        "edgeKinds": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "string", "minLength": 1 } },
        "direction": { "enum": ["outbound", "inbound", "both"] },
        "maximumDepth": { "type": "integer", "minimum": 1, "maximum": 5 },
        "maximumNodes": { "type": "integer", "minimum": 1, "maximum": 100000 }
      }
    },
    "mediaSegmentRead": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "operation", "assetId", "segmentParameterRef", "maximumSegments"],
      "properties": {
        "operationId": { "type": "string", "format": "uuid" },
        "operation": { "const": "media-segment-read" },
        "assetId": { "type": "string", "minLength": 1 },
        "segmentParameterRef": { "type": "string", "minLength": 1 },
        "maximumSegments": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    },
    "lineageRead": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "operation", "assetId", "maximumDepth"],
      "properties": {
        "operationId": { "type": "string", "format": "uuid" },
        "operation": { "const": "lineage-read" },
        "assetId": { "type": "string", "minLength": 1 },
        "maximumDepth": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "referenceRead": {
      "type": "object", "additionalProperties": false,
      "required": ["operationId", "operation", "assetId", "referencePath", "valueParameterRef", "maximumResults"],
      "properties": {
        "operationId": { "type": "string", "format": "uuid" },
        "operation": { "const": "reference-read" },
        "assetId": { "type": "string", "minLength": 1 },
        "referencePath": { "type": "string", "minLength": 1 },
        "valueParameterRef": { "type": "string", "minLength": 1 },
        "maximumResults": { "type": "integer", "minimum": 1, "maximum": 10000 }
      }
    }
  }
}
