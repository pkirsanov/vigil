{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-data-profiler.invalid/v1/benchmark-corpus.schema.json",
  "title": "Profiler Benchmark Corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["corpusVersion", "fixtureUse", "requiredSlices", "cases"],
  "properties": {
    "corpusVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "fixtureUse": { "const": "conformance-example-not-runtime-evidence" },
    "requiredSlices": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "uniqueItems": true,
      "items": { "enum": ["positive", "negative", "sparse", "skewed", "high-cardinality", "scoped", "versioned", "adversarial", "no-evidence"] }
    },
    "cases": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "fixtureRef", "fixtureSha256", "probe", "slices", "expectedOutcome", "expectedEvidenceKinds", "expectedManifestSections", "expectedRedactions", "unsupportedConclusions"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,99}$" },
          "fixtureRef": { "type": "string", "pattern": "^package://[A-Za-z0-9._/-]+$" },
          "fixtureSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
          "probe": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "pointer"],
            "properties": {
              "kind": { "const": "json-pointer-nonempty" },
              "pointer": { "type": "string", "pattern": "^/([^/~]|~[01])+(?:/([^/~]|~[01])+)*$", "maxLength": 500 }
            }
          },
          "slices": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["positive", "negative", "sparse", "skewed", "high-cardinality", "scoped", "versioned", "adversarial", "no-evidence"] } },
          "expectedOutcome": { "enum": ["accepted", "rejected", "completed-partial", "unavailable"] },
          "expectedEvidenceKinds": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
          "expectedManifestSections": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
          "expectedRedactions": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } },
          "unsupportedConclusions": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 200 } }
        }
      }
    }
  }
}
