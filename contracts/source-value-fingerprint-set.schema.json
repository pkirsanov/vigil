{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-data-profiler.invalid/v1/source-value-fingerprint-set.schema.json",
  "title": "Source Value Fingerprint Set",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "fingerprintSetId",
    "fixtureUse",
    "sourceId",
    "sourceVersion",
    "authorizationScopeId",
    "subjectHashSaltId",
    "fingerprintAlgorithm",
    "fingerprintGranularity",
    "normalizationVersion",
    "minimumFingerprintCharacterLength",
    "fingerprints",
    "fingerprintCount",
    "hashAlgorithm",
    "contentHash"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "fingerprintSetId": { "type": "string", "format": "uuid" },
    "fixtureUse": { "enum": ["conformance-only", "production"] },
    "sourceId": { "type": "string", "format": "uuid" },
    "sourceVersion": { "type": "string", "minLength": 1, "maxLength": 200 },
    "authorizationScopeId": { "type": "string", "minLength": 1, "maxLength": 500 },
    "subjectHashSaltId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "conformanceSalt": { "type": "string", "minLength": 16, "maxLength": 200, "description": "Required only for the sanitized conformance fixture. A production fingerprint set never publishes its deployment salt." },
    "conformanceSourceValues": { "type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1000 }, "description": "Sanitized values used only to prove the conformance derivation and collision checker. Production sets omit raw source values and use a deployment-side verifier." },
    "fingerprintAlgorithm": { "const": "hmac-sha256-deployment-salt-v1" },
    "fingerprintGranularity": { "const": "exact-and-alphanumeric-token-v1" },
    "normalizationVersion": { "const": "unicode-nfkc-trim-casefold-v1" },
    "minimumFingerprintCharacterLength": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "fingerprints": { "type": "array", "minItems": 1, "maxItems": 1000000, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" } },
    "fingerprintCount": { "type": "integer", "minimum": 1 },
    "hashAlgorithm": { "const": "sha256-jcs" },
    "contentHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$", "description": "SHA-256 over the RFC 8785 canonical set with contentHash removed." }
  },
  "allOf": [
    {
      "if": { "properties": { "fixtureUse": { "const": "conformance-only" } } },
      "then": { "required": ["conformanceSalt", "conformanceSourceValues"] }
    },
    {
      "if": { "properties": { "fixtureUse": { "const": "production" } } },
      "then": {
        "not": {
          "anyOf": [
            { "required": ["conformanceSalt"] },
            { "required": ["conformanceSourceValues"] }
          ]
        }
      }
    }
  ]
}
