{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-data-profiler.invalid/v1/projection-safety-receipt.schema.json",
  "title": "Projection Content Safety Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "receiptId",
    "runId",
    "coordinate",
    "profileContentHash",
    "capabilityContentHash",
    "sourceValueFingerprintSetId",
    "sourceValueFingerprintSetHash",
    "sourceValueFingerprintCount",
    "scannedTextFieldCount",
    "ordinaryRawValueCollisionCount",
    "secretCollisionCount",
    "directIdentifierCollisionCount",
    "minimumFingerprintCharacterLength",
    "fingerprintAlgorithm",
    "fingerprintGranularity",
    "normalizationVersion",
    "scannerVersion",
    "scannedAt",
    "hashAlgorithm",
    "receiptHash",
    "issuerKeyId",
    "signatureAlgorithm",
    "signature"
  ],
  "properties": {
    "receiptId": { "type": "string", "format": "uuid" },
    "runId": { "type": "string", "format": "uuid" },
    "coordinate": { "$ref": "projection-coordinate.schema.json" },
    "profileContentHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "capabilityContentHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "sourceValueFingerprintSetId": { "type": "string", "format": "uuid" },
    "sourceValueFingerprintSetHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$", "description": "SHA-256 over the RFC 8785 canonical sorted array of deployment-salted fingerprints for every authorized scalar source value meeting minimumFingerprintCharacterLength. The deployment salt never enters this package." },
    "sourceValueFingerprintCount": { "type": "integer", "minimum": 1 },
    "scannedTextFieldCount": { "type": "integer", "minimum": 1 },
    "ordinaryRawValueCollisionCount": { "const": 0 },
    "secretCollisionCount": { "const": 0 },
    "directIdentifierCollisionCount": { "const": 0 },
    "minimumFingerprintCharacterLength": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "fingerprintAlgorithm": { "const": "hmac-sha256-deployment-salt-v1" },
    "fingerprintGranularity": { "const": "exact-and-alphanumeric-token-v1" },
    "normalizationVersion": { "const": "unicode-nfkc-trim-casefold-v1" },
    "scannerVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "scannedAt": { "type": "string", "format": "date-time" },
    "hashAlgorithm": { "const": "sha256-jcs" },
    "receiptHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$", "description": "SHA-256 over the RFC 8785 canonical receipt with receiptHash and signature removed." },
    "issuerKeyId": { "type": "string", "minLength": 1, "maxLength": 255 },
    "signatureAlgorithm": { "const": "ed25519" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "minLength": 80, "maxLength": 100 }
  }
}
