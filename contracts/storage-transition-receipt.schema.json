{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-data-profiler.invalid/v1/storage-transition-receipt.schema.json",
  "title": "Conformance Storage Pointer Transition Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receiptId", "receiptUse", "storeIdentity", "pointerId", "preconditionRevision", "preconditionEtag", "committedRevision", "committedEtag", "transactionId", "readbackUri", "readbackSha256", "committedAt", "hashAlgorithm", "receiptHash", "issuerKeyId", "signatureAlgorithm", "signature"],
  "properties": {
    "receiptId": { "type": "string", "format": "uuid" },
    "receiptUse": { "const": "conformance-fixture" },
    "storeIdentity": { "type": "string", "minLength": 1, "maxLength": 255 },
    "pointerId": { "type": "string", "minLength": 1, "maxLength": 500 },
    "preconditionRevision": { "type": "integer", "minimum": 0 },
    "preconditionEtag": { "type": "string", "minLength": 1, "maxLength": 255 },
    "committedRevision": { "type": "integer", "minimum": 1 },
    "committedEtag": { "type": "string", "minLength": 1, "maxLength": 255 },
    "transactionId": { "type": "string", "format": "uuid" },
    "readbackUri": { "type": "string", "pattern": "^package://" },
    "readbackSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "committedAt": { "type": "string", "format": "date-time" },
    "hashAlgorithm": { "const": "sha256-jcs" },
    "receiptHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "issuerKeyId": { "type": "string", "minLength": 1, "maxLength": 255 },
    "signatureAlgorithm": { "const": "ed25519" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "minLength": 80, "maxLength": 100 }
  }
}
