{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-data-profiler.invalid/v1/source-descriptor.schema.json",
  "title": "Source Descriptor",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contractVersion",
    "sourceId",
    "registrationGeneration",
    "displayName",
    "kind",
    "connectorId",
    "connectorVersion",
    "connectorCapabilityHash",
    "locator",
    "authorizationScope",
    "credentialRef",
    "requestedCapabilities",
    "connectorDeclaredCapabilities",
    "policyAuthorizedCapabilities",
    "effectiveCapabilities",
    "policyRef",
    "registrationValidation"
  ],
  "properties": {
    "contractVersion": { "const": "1.0.0" },
    "sourceId": { "type": "string", "format": "uuid" },
    "registrationGeneration": { "type": "string", "minLength": 1, "maxLength": 100, "description": "Immutable registration-generation coordinate available before any source read; it is not a structural source version." },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 200 },
    "kind": {
      "enum": [
        "relational",
        "tabular-file",
        "semi-structured",
        "document-corpus",
        "api",
        "stream",
        "graph",
        "multimodal",
        "custom"
      ]
    },
    "connectorId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{2,127}$" },
    "connectorVersion": { "type": "string", "minLength": 1, "maxLength": 100 },
    "connectorCapabilityHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$", "description": "SHA-256 over the RFC 8785 canonical object { connectorId, connectorVersion, capabilities } with capabilities sorted ordinally." },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registeredEndpointId", "resource"],
      "properties": {
        "registeredEndpointId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._-]{2,127}$", "description": "Opaque endpoint-registry key; not a path and never composed into one." },
        "resource": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z][A-Za-z0-9._~-]*(?:/[A-Za-z][A-Za-z0-9._~-]*)*$" },
        "subresource": { "type": ["string", "null"], "maxLength": 500, "pattern": "^(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z][A-Za-z0-9._~-]*(?:/[A-Za-z][A-Za-z0-9._~-]*)*$" }
      }
    },
    "authorizationScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scopeId", "principalMode", "authorizedOperations"],
      "properties": {
        "scopeId": { "type": "string", "minLength": 1, "maxLength": 255 },
        "principalMode": { "enum": ["delegated", "service", "connector"] },
        "authorizedOperations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["enumerate", "read-structure", "read-content", "sample", "aggregate", "read-constraints", "read-lineage", "read-usage-history", "read-change-feed", "resolve-reference", "safe-probe"] }
        }
      }
    },
    "credentialRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providerId", "referenceId"],
      "properties": {
        "providerId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{2,127}$" },
        "referenceId": { "type": "string", "format": "uuid" }
      },
      "description": "A reference only. Secret material is forbidden."
    },
    "requestedCapabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "maxItems": 20,
      "items": {
        "enum": [
          "enumerate-assets",
          "read-structure",
          "estimate-size",
          "deterministic-sample",
          "aggregate-statistics",
          "read-constraints",
          "read-lineage",
          "read-usage-history",
          "read-change-feed",
          "fetch-content",
          "execute-safe-probe",
          "resolve-reference"
        ]
      }
    },
    "connectorDeclaredCapabilities": {
      "type": "array", "minItems": 1, "uniqueItems": true, "maxItems": 20,
      "items": { "enum": ["enumerate-assets", "read-structure", "estimate-size", "deterministic-sample", "aggregate-statistics", "read-constraints", "read-lineage", "read-usage-history", "read-change-feed", "fetch-content", "execute-safe-probe", "resolve-reference"] }
    },
    "policyAuthorizedCapabilities": {
      "type": "array", "uniqueItems": true, "maxItems": 20,
      "items": { "enum": ["enumerate-assets", "read-structure", "estimate-size", "deterministic-sample", "aggregate-statistics", "read-constraints", "read-lineage", "read-usage-history", "read-change-feed", "fetch-content", "execute-safe-probe", "resolve-reference"] }
    },
    "effectiveCapabilities": {
      "type": "array", "uniqueItems": true, "maxItems": 20,
      "items": { "enum": ["enumerate-assets", "read-structure", "estimate-size", "deterministic-sample", "aggregate-statistics", "read-constraints", "read-lineage", "read-usage-history", "read-change-feed", "fetch-content", "execute-safe-probe", "resolve-reference"] },
      "description": "Intersection of requested, connector-declared, and policy-authorized capabilities."
    },
    "policyRef": { "type": "string", "minLength": 1 },
    "registrationValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["secretScanPassed", "locatorValidated", "credentialReferenceResolved", "endpointRegistryVersion", "credentialRegistryVersion", "checkedAt"],
      "properties": {
        "secretScanPassed": { "const": true },
        "locatorValidated": { "const": true },
        "credentialReferenceResolved": { "const": true },
        "endpointRegistryVersion": { "type": "string", "minLength": 1 },
        "credentialRegistryVersion": { "type": "string", "minLength": 1 },
        "checkedAt": { "type": "string", "format": "date-time" }
      }
    },
    "tags": {
      "type": "object",
      "maxProperties": 20,
      "additionalProperties": { "type": "string", "maxLength": 200 }
    }
  }
}
