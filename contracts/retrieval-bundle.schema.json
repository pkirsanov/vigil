{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-data-profiler.invalid/v1/retrieval-bundle.schema.json",
  "title": "Authorized Retrieval Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "coordinate",
    "traceId",
    "responsePolicy",
    "query",
    "items",
    "coverageReceipt",
    "caveats",
    "conflicts"
  ],
  "properties": {
    "coordinate": { "$ref": "projection-coordinate.schema.json" },
    "traceId": { "type": "string", "minLength": 1, "maxLength": 100 },
    "responsePolicy": { "$ref": "agent-response-policy.schema.json" },
    "query": { "type": "string", "minLength": 1, "maxLength": 4000 },
    "items": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "summary", "contentProvenance", "score", "scoreComponents", "confidence", "maturity", "validity", "evidenceRefs", "counterEvidenceRefs", "warnings"],
        "properties": {
          "subject": { "type": "string", "minLength": 1, "maxLength": 500 },
          "summary": { "type": "string", "minLength": 1, "maxLength": 4000 },
          "contentProvenance": { "enum": ["service-generated", "source-derived"] },
          "score": { "type": "number", "minimum": 0, "maximum": 1 },
          "scoreComponents": {
            "type": "object",
            "propertyNames": { "type": "string", "minLength": 1, "maxLength": 100 },
            "additionalProperties": { "type": "number", "minimum": 0, "maximum": 1 },
            "maxProperties": 20
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "maturity": { "enum": ["observed", "inferred", "validated", "curated", "usage-proven"] },
          "validity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["validFrom", "validUntil"],
            "properties": {
              "validFrom": { "type": "string", "format": "date-time" },
              "validUntil": { "type": ["string", "null"], "format": "date-time" }
            }
          },
          "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
          "counterEvidenceRefs": { "type": "array", "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
          "warnings": { "type": "array", "maxItems": 50, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
        }
      }
    },
    "coverageReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorizedCandidatesConsidered", "returnedItems", "caveatsConsidered", "returnedCaveats", "conflictsConsidered", "returnedConflicts", "omittedBySection", "truncated", "reason"],
      "properties": {
        "authorizedCandidatesConsidered": { "type": "integer", "minimum": 0 },
        "returnedItems": { "type": "integer", "minimum": 0, "maximum": 100 },
        "caveatsConsidered": { "type": "integer", "minimum": 0 },
        "returnedCaveats": { "type": "integer", "minimum": 0, "maximum": 50 },
        "conflictsConsidered": { "type": "integer", "minimum": 0 },
        "returnedConflicts": { "type": "integer", "minimum": 0, "maximum": 50 },
        "omittedBySection": {
          "type": "object",
          "additionalProperties": false,
          "required": ["items", "caveats", "conflicts"],
          "properties": {
            "items": { "type": "integer", "minimum": 0 },
            "caveats": { "type": "integer", "minimum": 0 },
            "conflicts": { "type": "integer", "minimum": 0 }
          }
        },
        "truncated": { "type": "boolean" },
        "reason": { "type": ["string", "null"], "maxLength": 500 }
      }
    },
    "caveats": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["summary", "contentProvenance", "evidenceRefs"],
        "properties": {
          "summary": { "type": "string", "minLength": 1, "maxLength": 500 },
          "contentProvenance": { "enum": ["service-generated", "source-derived"] },
          "evidenceRefs": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject", "claim", "contentProvenance", "supportingEvidenceRefs", "counterEvidenceRefs"],
        "properties": {
          "subject": { "type": "string", "minLength": 1, "maxLength": 500 },
          "claim": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "contentProvenance": { "enum": ["service-generated", "source-derived"] },
          "supportingEvidenceRefs": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } },
          "counterEvidenceRefs": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } }
        }
      }
    }
  }
}
