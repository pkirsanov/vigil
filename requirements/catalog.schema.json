{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.agent-data-profiler.invalid/v1/requirements-catalog.schema.json",
  "title": "Requirements Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["catalogVersion", "semanticBindingAlgorithm", "semanticBindingHash", "supplementaryScenarios", "requirements"],
  "properties": {
    "catalogVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "semanticBindingAlgorithm": { "const": "sha256-jcs-acceptance-outcomes-v1" },
    "semanticBindingHash": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "supplementaryScenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenarioRef", "rationale"],
        "properties": {
          "scenarioRef": { "type": "string", "pattern": "^[a-z0-9-]+:[^:]+$" },
          "rationale": { "type": "string", "minLength": 20, "maxLength": 500 }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "priority", "statement", "acceptance", "bdd"],
        "properties": {
          "id": { "type": "string", "pattern": "^(FR|NFR)-[0-9]{3}$" },
          "title": { "type": "string", "minLength": 3, "maxLength": 200 },
          "priority": { "enum": ["P0", "P1", "P2", "P3"] },
          "statement": { "type": "string", "minLength": 20 },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "pattern": "^AC-[0-9]{2}$" },
                "text": { "type": "string", "minLength": 10 }
              }
            }
          },
          "bdd": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["acceptanceId", "scenarioRef"],
              "properties": {
                "acceptanceId": { "type": "string", "pattern": "^AC-[0-9]{2}$" },
                "scenarioRef": { "type": "string", "pattern": "^[a-z0-9-]+:[^:]+$" }
              }
            }
          }
        }
      }
    }
  }
}
